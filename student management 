#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILENAME "students.dat"
#define TEMP_FILE "temp.dat"
#define MAX_NAME 50
#define MAX_COURSE 30

typedef struct {
    int rollNo;
    char name[MAX_NAME];
    char course[MAX_COURSE];
    float marks;
} Student;

void clearInputBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) {}
}

void readLine(char *buffer, size_t size) {
    if (fgets(buffer, (int)size, stdin) != NULL) {
        size_t len = strlen(buffer);
        if (len > 0 && buffer[len - 1] == '\n') {
            buffer[len - 1] = '\0';
        } else {
            // Input exceeded buffer size; flush remaining characters to prevent overflow into next prompt
            clearInputBuffer();
        }
    } else {
        buffer[0] = '\0';
    }
}

int readInt(const char *prompt) {
    int value;
    while (1) {
        printf("%s", prompt);
        if (scanf("%d", &value) == 1) {
            clearInputBuffer();
            return value;
        }
        printf("Invalid input. Please enter a valid integer.\n");
        clearInputBuffer();
    }
}

float readFloat(const char *prompt, float minVal, float maxVal) {
    float value;
    while (1) {
        printf("%s", prompt);
        if (scanf("%f", &value) == 1) {
            clearInputBuffer();
            if (value >= minVal && value <= maxVal) {
                return value;
            }
            printf("Out of bounds: Please enter a value between %.2f and %.2f.\n", minVal, maxVal);
        } else {
            printf("Invalid input. Please enter a valid number.\n");
            clearInputBuffer();
        }
    }
}

void addStudent(void) {
    Student s, temp;

    s.rollNo = readInt("Enter Roll Number (positive integer): ");
    if (s.rollNo <= 0) {
        printf("Out of bounds: Roll Number must be greater than 0.\n");
        return;
    }

    // Check for duplicate roll number
    FILE *checkFp = fopen(FILENAME, "rb");
    if (checkFp != NULL) {
        while (fread(&temp, sizeof(Student), 1, checkFp) == 1) {
            if (temp.rollNo == s.rollNo) {
                printf("Error: A student with Roll No %d already exists.\n", s.rollNo);
                fclose(checkFp);
                return;
            }
        }
        fclose(checkFp);
    }

    printf("Enter Full Name (max %d chars): ", MAX_NAME - 1);
    readLine(s.name, sizeof(s.name));
    if (strlen(s.name) == 0) {
        printf("Error: Name cannot be empty.\n");
        return;
    }

    printf("Enter Course (max %d chars): ", MAX_COURSE - 1);
    readLine(s.course, sizeof(s.course));
    if (strlen(s.course) == 0) {
        printf("Error: Course cannot be empty.\n");
        return;
    }

    s.marks = readFloat("Enter Marks (0 - 100): ", 0.0f, 100.0f);

    FILE *fp = fopen(FILENAME, "ab");
    if (fp == NULL) {
        perror("Unable to open file");
        return;
    }

    if (fwrite(&s, sizeof(Student), 1, fp) != 1) {
        perror("Failed to write student record");
    } else {
        printf("Student record added successfully.\n");
    }
    fclose(fp);
}

void displayStudents(void) {
    FILE *fp = fopen(FILENAME, "rb");
    if (fp == NULL) {
        printf("No records found.\n");
        return;
    }

    Student s;
    int count = 0;
    printf("\n%-10s %-30s %-20s %-10s\n", "Roll No", "Name", "Course", "Marks");
    printf("------------------------------------------------------------------------\n");
    while (fread(&s, sizeof(Student), 1, fp) == 1) {
        // Ensure null-termination against corrupted file bytes
        s.name[MAX_NAME - 1] = '\0';
        s.course[MAX_COURSE - 1] = '\0';
        printf("%-10d %-30s %-20s %-10.2f\n", s.rollNo, s.name, s.course, s.marks);
        count++;
    }
    if (count == 0) {
        printf("No student records available.\n");
    }
    fclose(fp);
}

void searchStudent(void) {
    FILE *fp = fopen(FILENAME, "rb");
    if (fp == NULL) {
        printf("No records found.\n");
        return;
    }

    int roll = readInt("Enter Roll Number to search: ");
    if (roll <= 0) {
        printf("Out of bounds: Roll Number must be greater than 0.\n");
        fclose(fp);
        return;
    }

    int found = 0;
    Student s;
    while (fread(&s, sizeof(Student), 1, fp) == 1) {
        if (s.rollNo == roll) {
            s.name[MAX_NAME - 1] = '\0';
            s.course[MAX_COURSE - 1] = '\0';
            printf("\nRecord Found:\n");
            printf("Roll No : %d\n", s.rollNo);
            printf("Name    : %s\n", s.name);
            printf("Course  : %s\n", s.course);
            printf("Marks   : %.2f\n", s.marks);
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Student with Roll No %d not found.\n", roll);
    }
    fclose(fp);
}

void updateStudent(void) {
    FILE *fp = fopen(FILENAME, "rb+");
    if (fp == NULL) {
        printf("No records found.\n");
        return;
    }

    int roll = readInt("Enter Roll Number to update: ");
    if (roll <= 0) {
        printf("Out of bounds: Roll Number must be greater than 0.\n");
        fclose(fp);
        return;
    }

    int found = 0;
    Student s;
    while (fread(&s, sizeof(Student), 1, fp) == 1) {
        if (s.rollNo == roll) {
            s.name[MAX_NAME - 1] = '\0';
            s.course[MAX_COURSE - 1] = '\0';

            printf("Enter New Name (current: %s): ", s.name);
            readLine(s.name, sizeof(s.name));

            printf("Enter New Course (current: %s): ", s.course);
            readLine(s.course, sizeof(s.course));

            s.marks = readFloat("Enter New Marks (0 - 100): ", 0.0f, 100.0f);

            if (fseek(fp, -(long)sizeof(Student), SEEK_CUR) != 0 ||
                fwrite(&s, sizeof(Student), 1, fp) != 1) {
                perror("Error updating record");
            } else {
                printf("Record updated successfully.\n");
            }
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Student with Roll No %d not found.\n", roll);
    }
    fclose(fp);
}

void deleteStudent(void) {
    FILE *fp = fopen(FILENAME, "rb");
    if (fp == NULL) {
        printf("No records found.\n");
        return;
    }

    int roll = readInt("Enter Roll Number to delete: ");
    if (roll <= 0) {
        printf("Out of bounds: Roll Number must be greater than 0.\n");
        fclose(fp);
        return;
    }

    FILE *tempFp = fopen(TEMP_FILE, "wb");
    if (tempFp == NULL) {
        perror("Unable to create temporary file");
        fclose(fp);
        return;
    }

    int found = 0;
    Student s;
    while (fread(&s, sizeof(Student), 1, fp) == 1) {
        if (s.rollNo == roll) {
            found = 1;
        } else {
            if (fwrite(&s, sizeof(Student), 1, tempFp) != 1) {
                perror("Write error during delete");
                fclose(fp);
                fclose(tempFp);
                remove(TEMP_FILE);
                return;
            }
        }
    }

    fclose(fp);
    fclose(tempFp);

    if (found) {
        if (remove(FILENAME) == 0 && rename(TEMP_FILE, FILENAME) == 0) {
            printf("Student record deleted successfully.\n");
        } else {
            perror("Error finalizing deletion");
        }
    } else {
        remove(TEMP_FILE);
        printf("Student with Roll No %d not found.\n", roll);
    }
}

int main(void) {
    int choice;
    while (1) {
        printf("\n=== STUDENT MANAGEMENT SYSTEM ===\n");
        printf("1. Add Student Record\n");
        printf("2. Display All Records\n");
        printf("3. Search Student\n");
        printf("4. Update Student\n");
        printf("5. Delete Student\n");
        printf("6. Exit\n");
        choice = readInt("Enter your choice (1-6): ");

        switch (choice) {
            case 1: addStudent(); break;
            case 2: displayStudents(); break;
            case 3: searchStudent(); break;
            case 4: updateStudent(); break;
            case 5: deleteStudent(); break;
            case 6:
                printf("Exiting Student Management System.\n");
                return 0;
            default:
                printf("Out of bounds: Please select an option between 1 and 6.\n");
        }
    }
}
